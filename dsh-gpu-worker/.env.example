# Copy to .env (or set these as real environment variables) before starting.
# DSH_GPU_WORKER_TOKEN is REQUIRED: the worker refuses to start without it.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DSH_GPU_WORKER_TOKEN=change-me-to-a-long-random-token

# Bind address. Default 127.0.0.1 (local only). Use 0.0.0.0 for LAN access and
# open the Windows firewall for TCP 8765 only on trusted networks.
DSH_GPU_WORKER_HOST=127.0.0.1
DSH_GPU_WORKER_PORT=8765

# Optional: fixed work root (defaults to the project directory).
# DSH_GPU_WORKER_ROOT=
# Optional: SQLite database file (defaults to <root>/worker.db).
# DSH_GPU_WORKER_DB=

# Max tasks running at the same time (default 1).
DSH_GPU_WORKER_MAX_CONCURRENT_TASKS=1

# generic_python jobs (whitelisted scripts under scripts/jobs/ only).
# Set to false to disable this task type entirely.
DSH_GPU_WORKER_ALLOW_GENERIC_PYTHON=true
